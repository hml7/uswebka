import (
    "std.um"
    "nodes.um"
)

fn get_file_content(file_name: str): str {
    file, err := std::fopen(file_name, "rb")
    std::exitif(err)

    var file_content: str
    file_content, err = std::freadall(file)
    std::exitif(err)

    return file_content
}

fn parse_heading(content: str, start: int): ^nodes::HeadingNode {
    heading := new(nodes::HeadingNode)
    heading.level = 0

    index := start

    for index < len(content) && heading.level < 6 {
        if content[index] != '#' {
            break
        }

        heading.level++
        index++
    }

    if index >= len(content) || content[index] != ' ' {
        return null
    }

    index++
    content_start := index

    for index < len(content) && content[index] != '\n' {
        index++
    }

    heading.content = slice(content, content_start, index)

    return heading
}

fn parse_paragraph(content: str, start: int): ^nodes::ParagraphNode {
    paragraph := new(nodes::ParagraphNode)

    index := start

    for index < len(content) {
        if content[index] == '\n' {
            break
        }
        index++
    }

    paragraph.content = slice(content, start, index)

    return paragraph
}

fn parse_markdown(content: str): ^nodes::DocumentNode {
    doc := new(nodes::DocumentNode)

    index := 0
    file_length := len(content)

    for index < file_length {
        ch := content[index]

        // Heading
        if ch == '#' && (index == 0 || content[index - 1] == '\n') {
            heading := parse_heading(content, index)

            if heading != null {
                doc.children = append(
                    doc.children,
                    nodes::Node(heading)
                )

                for index < file_length && content[index] != '\n' {
                    index++
                }

                if index < file_length {
                    index++
                }

                continue
            }
        }

        // TODO: Paragraph - it's too primitive
        if (index == 0 || content[index - 1] == '\n') {
            paragraph := parse_paragraph(content, index)

            if paragraph != null {
                doc.children = append(
                    doc.children,
                    nodes::Node(paragraph)
                )
            }
        }
        index++
    }

    return doc
}

fn main() {
    argc := std::argc()

    if argc < 2 {
        printf("usage: uswebka <file.md>\n")
        return
    }

    file_name := std::argv(1)
    file_content := get_file_content(file_name)

    doc := parse_markdown(file_content)
    html := doc.render()

    printf("%s", html)
}
