import "std.um"

fn get_file_content(file_name: str): str {
    file, err := std::fopen(file_name, "r")
    std::exitif(err)

    var file_content: str
    file_content, err = std::freadall(file)
    std::exitif(err)

    return file_content
}

fn main() {
    argc := std::argc()

    if argc < 2 {
        printf("wrong usage\n")
    }

    file_name := std::argv(1)
    file_content := get_file_content(file_name)

    printf(file_content)
}
