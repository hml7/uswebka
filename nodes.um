import "std.um"

type Node* = interface {
    render() : str
}

type TextNode* = struct {
    content : str
}

type HeadingNode* = struct {
    level : int
    content : str
}

type ParagraphNode* = struct {
    content : str
}

type DocumentNode* = struct {
    children : []Node
}

fn (node : ^TextNode) render*() : str {
    return node.content
}

fn (node : ^HeadingNode) render*() : str {
    return "<h" + std::itoa(node.level) + ">" +
        node.content +
        "</h" + std::itoa(node.level) + ">"
}

fn (node : ^ParagraphNode) render*() : str {
    return "<p>" + node.content + "</p>"
}

fn (node : ^DocumentNode) render*() : str {
    var result : str

    for _, child in node.children {
        result += child.render()
        result += "\n"
    }

    return result
}
